<script>
(function(){
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Hero copy branching by campaign entry point: ?ad=curiosity | loss | authority
  var variants = {
    curiosity: {
      title: '3D 설계,<br><span class="hi">유튜브로만 보셨죠?</span>',
      sub: '스케치 한 장이 오늘 안에 실물이 됩니다. Fusion 원데이 클래스에서 직접 확인하세요.'
    },
    loss: {
      title: '이번 기수를 놓치면,<br><span class="hi">내년에도 2D에 머물 수 있습니다</span>',
      sub: '정부 예산 소진 시 접수가 조기 마감될 수 있습니다. 국비지원 최대 90% 환급 조건을 지금 확인하세요.'
    }
  };
  try{
    var params = new URLSearchParams(window.location.search);
    var v = variants[params.get('ad')];
    if(v){
      document.getElementById('heroTitle').innerHTML = v.title;
      document.getElementById('heroSub').textContent = v.sub;
    }
  }catch(e){}

  // Hero background video: hide fallback once iframe loads, respect reduced motion (skip autoplay video, keep static fallback only)
  var heroVideo = document.getElementById('heroVideo');
  var heroFallback = document.getElementById('heroFallback');
  if(reduceMotion){
    heroVideo.remove();
  } else {
    heroVideo.addEventListener('load', function(){ heroFallback.style.opacity = '0'; });
  }

  // Feature video click-to-play
  document.querySelectorAll('.video-inner').forEach(function(box){
    box.addEventListener('click', function(){
      var id = box.getAttribute('data-video-id');
      box.innerHTML = '<iframe src="https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0" title="YouTube video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
    });
  });

  // Mobile sticky CTA: show after hero is scrolled past
  var stickyCta = document.getElementById('stickyCta');
  var heroEl = document.querySelector('.hero');
  var applyEl = document.getElementById('apply');
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(entry.target === heroEl){
        if(!entry.isIntersecting) stickyCta.classList.add('show');
        else stickyCta.classList.remove('show');
      }
    });
  }, { threshold: 0 });
  io.observe(heroEl);
  var applyIo = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(entry.isIntersecting) stickyCta.classList.remove('show');
    });
  }, { threshold: 0.3 });
  applyIo.observe(applyEl);

  // Subtle hero parallax (background layer drifts slower than scroll)
  if(!reduceMotion){
    var bg = document.querySelector('.hero-bg');
    var ticking = false;
    function onScroll(){
      if(!ticking){
        window.requestAnimationFrame(function(){
          var y = window.scrollY || window.pageYOffset;
          if(y < window.innerHeight * 1.2){
            bg.style.transform = 'translateY(' + (y * 0.25).toFixed(1) + 'px)';
          }
          ticking = false;
        });
        ticking = true;
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
  }
})();
</script>
